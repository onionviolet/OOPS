{
  "name": "oops-progression-simulator",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.js",
    "serve": "python3 -m http.server 8123 --bind 127.0.0.1",
    "test": "node scripts/slot_run.mjs --kind suite --slots 1 --max-load 12 --load-wait 300 -- node --test --test-concurrency=4 tests/*.test.js",
    "test:raw": "node --test tests/*.test.js",
    "ink:compile": "node scripts/compile_feature_ink.mjs",
    "ink:check": "node scripts/compile_feature_ink.mjs --check",
    "check:arch": "node scripts/check_architecture.mjs",
    "check:rules": "node scripts/check_rules_index.mjs && node scripts/check_receipts.mjs && node scripts/check_direction_sync.mjs && node scripts/check_player_text.mjs && node scripts/check_names.mjs && node scripts/check_continuity.mjs",
    "check:player-text": "node scripts/check_player_text.mjs",
    "check:names": "node scripts/check_names.mjs",
    "check:continuity": "node scripts/check_continuity.mjs",
    "check:pacing": "node scripts/check_pacing.mjs",
    "check:openings": "node scripts/check_openings.mjs",
    "check:feedback": "node scripts/check_feedback.mjs",
    "check:receipts": "node scripts/check_receipts.mjs",
    "check:docs": "node scripts/check_doc_slips.mjs",
    "check:descriptions": "node scripts/check_descriptions.mjs",
    "check:generators": "node scripts/check_generators.mjs",
    "report:cycles": "node scripts/cycle_ledger.mjs",
    "check:rule-behavior": "node scripts/check_rule_behavior.mjs",
    "build:preview": "node scripts/build_ui_preview.mjs",
    "build:figures": "node scripts/build_figure_gallery.mjs",
    "desktop": "npm run tauri",
    "tauri": "npm run build && node scripts/tauri/app.mjs snapshot && node scripts/tauri/app.mjs open",
    "tauri:install": "npm run build && node scripts/tauri/app.mjs install",
    "check:tauri": "node scripts/tauri/check.mjs",
    "mcp:game": "node scripts/mcp/game_mcp.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "esbuild": "0.25.10"
  },
  "dependencies": {
    "inkjs": "2.4.0"
  }
}
