  "original_adaptation": {
    "id": "CK3-P1",
    "label": "A practical guild coalition",
    "status": "proposal_unselected_unimplemented",
    "prerequisites": "Actual independent actors, disclosed levy terms and a meaningful authority/right. Optional existing-world enrollment only.",
    "player_and_npc_choices": "Join, contribute real means, provide bounded testimony under a witnessed obligation, oppose, negotiate or refuse independently.",
    "real_cost_and_time": "Use actual coins, paid time, conserved tool rights and actor body readiness; numerical balance unselected.",
    "state_mutation": "Issue-specific membership and contribution/obligation receipts, distinct from relationship axes.",
    "downstream_consumer": "Authority changes access/work rule, negotiates exemption or refuses; actors choose paid alternatives using actual means.",
    "failure_and_aftermath": "Unsupported or withdrawn contributions cannot count; refusal preserves affection and leaves real access consequences; permanent closure survives display pruning.",
    "native_owner_fit": "Use existing identities, claims, inventory, knowledge, jobs, clock, native host and durable publisher. Ink observes and presents eligible choices.",
    "missing_consumers": [
      "typed demand/membership commitment",
      "aggregate practical support projection",
      "bounded obligation use",
      "authority decision and aftermath",
      "durable closure/readback"
    ],
    "compatibility": "Integrator must select any durable carrier/migration policy. Absent optional state inert; no new save schema or social currency selected.",
    "later_gate": "Hold liking constant while changing burden, neighbor commitment or means; observe different legal participation/response plus conserved contribution, bounded obligation, refusal and fixture reload/return.",
    "gate_run": false
  },
  "fit_and_cost": {
    "development_speed": "Data/content adaptation likely faster than engine transplant; no benchmark measured.",
    "game_save_reuse": "Current JS+Ink keeps actors and staged durable host plans; CK3 code reuse unavailable here.",
    "social_narrative": "High-value conceptual separation of emotion, issue commitment, leverage and institution.",
    "simulation": "Selective bounded case fits existing predicate/controllers; whole arbitrary realm simulation unproven.",
    "spatial_presentation": "No demonstrated need for CK3 territory map to improve this case.",
    "authoring_modularity": "Leaf definitions plus observed Ink scene; source scripts not inspected as reusable authoring tools.",
    "maintenance": "Qualitative medium for a bounded case, high for whole-game transplant; legal participation/cost/aftermath must still be authored.",
    "engine_switch_reason": "Park: no inspected source library or native adapter; ruler/dynasty/map state would create substantial migration with no demonstrated whole-task gain."
  },
