      "series": "Jujutsu Kaisen",
      "wiki": "jujutsu-kaisen.fandom.com",
      "page": "Binding Vow",
      "section": "Known Vows",
      "text": "A later-use activation debt can buy an immediate exception. Another bargain can be completed by killing a target and healing them at that same moment. The page leaves one disputed party-specific no-harm bargain unresolved.",
      "proposal": "Track future activation obligations, fulfillment events and contested breach findings separately.",
      "status": "dated_secondary_dump_review",
      "revision_id": "78401",
      "page_timestamp": "2026-02-05T04:48:35Z",
