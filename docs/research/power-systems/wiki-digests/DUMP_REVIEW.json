    {
      "id": "DJ7",
      "series": "Jujutsu Kaisen",
      "wiki": "jujutsu-kaisen.fandom.com",
      "page": "Domain Expansion",
      "section": "Lethal Domains; Non-Lethal Domains; Incomplete Domains; Drawbacks; Countermeasures",
      "text": "Domains can impose procedures rather than lethal sure hits. Incomplete domains lack some sure-hit functions. Anti-domain methods can disable a barrier's sure-hit rule; casting can leave the innate method temporarily unstable afterward.",
      "proposal": "Represent rule installation, damage, detection, clash and post-use burnout as separate states.",
