    {
      "id": "DJ5",
      "series": "Jujutsu Kaisen",
      "wiki": "jujutsu-kaisen.fandom.com",
      "page": "Deadly Sentencing",
      "section": "Description; Sentencing",
      "text": "The court domain bans violence on both sides, requires rule explanation and uses evidence and presented statements. Its judge's knowledge is not all shared with the caster. Confiscation prioritizes a carried cursed tool; without an innate technique it instead removes cursed-energy use. Execution targets the condemned soul when several share a body.",
      "proposal": "Separate judge knowledge, disclosed evidence, verdict, sanction routing and the soul legally targeted.",
      "status": "dated_secondary_dump_review",
      "revision_id": "73036",
      "page_timestamp": "2025-06-23T21:36:42Z",
      "source_url": "https://jujutsu-kaisen.fandom.com/wiki/Deadly_Sentencing?oldid=73036",
