    },
    {
      "id": "DJ6",
      "series": "Jujutsu Kaisen",
      "wiki": "jujutsu-kaisen.fandom.com",
      "page": "Culling Game",
      "section": "Rules; About the Culling Game",
      "text": "Participants can spend points to add rules through a constrained authority. Point transfer and exit rules are later additions. Entry consequences, removal sanctions and barrier transport are separate rules; killing the organizer does not itself end the ritual.",
      "proposal": "A rule-writing power needs admissibility, authority, a dated rule set and independent barrier effects.",
