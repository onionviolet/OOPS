  "root_mechanics": [
    {
      "id": "M4",
      "title": "Home/faction growth and actionable research",
      "caller": "GameDate.AdvanceDay -> Faction.OnAdvanceDay -> FactionBranch.OnAdvanceDay",
      "observed": [
        "OnAdvanceDay increments days together only for co-present/party members, then earns probabilistic branch XP from default residents and extra Pioneer work.",
        "ModExp is stopped by policy2515, modified by2516 and invokes Upgrade only after GetNextExp and CanUpgrade. MaxLv7, demo stops growth at3.",
