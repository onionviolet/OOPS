  "proposals": [
    {
      "id": "P1",
      "disposition": "adapt",
      "title": "One shared layer contract",
      "owner": "docs/ENGINE_AUTHORING.md; docs/ENGINE_EXPANSION.md",
      "findings": "F6,F8,F13,F16,F18",
      "proposal": "Require a stable namespaced ID, owner, version, clock units, input/output means, reset domains, carry rules, public display and discovery rules. Keep content separate while the host owns commit order and persistence.",
      "cost": "Medium authoring cost; avoids a framework port."
    },
    {
      "id": "P2",
      "disposition": "adapt",
      "title": "Show why progress slowed",
      "owner": "docs/ENGINE_EXPANSION.md; docs/THEMATIC_UI_AND_INFORMATION_DESIGN_2026-10-12.md",
      "findings": "F3,F4,F10",
      "proposal": "Use one balance record to compute and explain known soft limits, thresholds and earned relief. Show current effect and next useful action beside the resource.",
      "cost": "Small first slice; wider formula coverage needs care."
    },
    {
      "id": "P3",
      "disposition": "adapt",
      "title": "Retain completed sections as useful passive activity",
      "owner": "docs/ENGINE_EXPANSION.md; docs/worlds/MULTIVERSE_STRUCTURES.md",
      "findings": "F9,F11",
      "proposal": "Separate discovered, visible, active, retained and progressing states. Completed activity can feed a known hub with its own saved clock and queue; offer authored revisits rather than a global one-shot ladder.",
      "cost": "Medium scheduling and save cost; distinct worlds keep their own rules."
    },
    {
      "id": "P4",
      "disposition": "adapt",
      "title": "Use one requirement result for action and display",
      "owner": "docs/ENGINE_AUTHORING.md; docs/ENGINE_EXPANSION.md",
      "findings": "F13,F14,F15",
      "proposal": "Build costs, non-spent needs, failed reasons and allowed quantity from the existing preview. Aggregate shared-resource costs and commit through existing planned state.",
      "cost": "Small display slice; generic bulk purchase is separate medium work."
    },
    {
      "id": "P5",
      "disposition": "trial",
      "title": "Keep a desktop overview beside useful detail",
      "owner": "docs/THEMATIC_UI_AND_INFORMATION_DESIGN_2026-10-12.md",
      "findings": "F4,F5,F7,F8",
      "proposal": "At 1440x900 show an overview, selected system and retained activity panel. Use tabs for long detail while routine controls remain visible. Distinguish unlock links from reset effects.",
      "cost": "Prototype needs rebuilt desktop evidence; mobile optimization deferred."
    },
    {
      "id": "P6",
      "disposition": "adapt",
      "title": "Give authors a cross-system balance review",
      "owner": "docs/ENGINE_AUTHORING.md; docs/ENGINE_EXPANSION.md",
      "findings": "F10,F12,F15,F17",
      "proposal": "Review named dependencies and sample trajectories when a system changes. Check both path orders, idle/active rhythms, reset recovery and strong feedback cycles. Keep all reasonable routes reachable.",
      "cost": "Medium tooling cost; no claim of automatic balance."
    },
    {
      "id": "P7",
      "disposition": "trial",
      "title": "Offer voluntary automation in one clear panel",
      "owner": "docs/ENGINE_EXPANSION.md; docs/THEMATIC_UI_AND_INFORMATION_DESIGN_2026-10-12.md",
      "findings": "F5,F7",
      "proposal": "Surface learned routines with current inputs, switches and pause reasons. Turn earned convenience into explicit controls, with execution still governed by real resources and safe boundaries.",
      "cost": "Small presentation slice; avoid an extra scheduler."
    }
  ],
