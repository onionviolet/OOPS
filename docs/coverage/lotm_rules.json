        "docs/gm/dispatch/potion-pathways-2026-10-24/PATHWAY_POTION_TABLE.md#01-rules-that-apply-to-every-row (Seq 0 and 1)",
        "lotm_c_0269.xhtml",
        "lotm_c_0327.xhtml",
        "lotm_c_0412.xhtml",
        "lotm_c_0449.xhtml"
      ],
      "speaker": "character; scene (Blasphemy Card, Fool 0 formula)",
      "mechanism": "brew_law, two main slots (Uniqueness, then Sequence 1 characteristics)",
