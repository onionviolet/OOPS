+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { normalizeLayout, parseLayout, presetLayout, reorderModule, changeModule, layoutStorageKey } from '../src/workspace_state.js';
+test('corrupt and future state recovers with all registered modules', () => {
+    assert.deepEqual(parseLayout('{', ['skills', 'journal']), normalizeLayout(null, ['skills', 'journal']));
+    assert.equal(normalizeLayout({version: 99, modules: [{id:'skills', hidden:true}]}, ['skills']).modules[0].hidden, false);
+});
+test('import strips unknown ids and all text or game data; clamps geometry', () => {
+    const v = normalizeLayout({version:1, modules:[{id:'skills',dock:'secret-place',width:90000,height:-1,x:-30,y:Infinity,hidden:true,truth:'sealed'}, {id:'unknown'}]}, ['skills']);
+    assert.equal(v.modules.length,1); assert.equal(v.modules[0].width,1000); assert.equal(v.modules[0].height,180); assert.equal(v.modules[0].x,0); assert.equal(v.modules[0].dock,'left'); assert.equal('truth' in v.modules[0],false);
+});
+test('reordering is local to dock and pinned panel cannot move', () => {
+    let v = presetLayout('Focus',['a','b','c']);
+    v = reorderModule(v,'c',-1); assert.deepEqual(v.modules.map(v=>v.id),['a','c','b']);
+    v = changeModule(v,'c',{pinned:true}); assert.equal(reorderModule(v,'c',-1),v);
+    v = changeModule(v,'b',{dock:'right'}); assert.equal(reorderModule(v,'a',1).modules.find(v=>v.id==='b').dock,'right');
+});
+test('presets reset visibility, while new modules recover and device storage separates', () => {
+    let v = changeModule(presetLayout('Classic',['a']), 'a', {hidden:true});
+    v = normalizeLayout(v,['a','b']); assert.equal(v.modules[0].hidden,true); assert.equal(v.modules[1].hidden,false);
+    assert.equal(presetLayout('Classic',['a']).modules[0].hidden,false);
+    assert.notEqual(layoutStorageKey(true), layoutStorageKey(false));
+});
+test('Classic restores native mode; dock mode survives changes and layout roundtrip', () => {
+    assert.equal(presetLayout('Classic',['skills']).mode,'classic');
+    const dock = changeModule(presetLayout('Compare',['skills','journal']), 'skills', {collapsed:true});
+    assert.equal(dock.mode,'dock');
+    assert.equal(parseLayout(JSON.stringify(reorderModule(dock,'skills',1)), ['skills','journal']).mode,'dock');
+    assert.equal(normalizeLayout({version:1,mode:'unsafe',modules:[]}, ['skills']).mode,'classic');
+});
+test('density preferences survive mutations and export; unknown preferences recover', () => {
+    const layout = presetLayout('Compare',['skills']); layout.density='inspection';
