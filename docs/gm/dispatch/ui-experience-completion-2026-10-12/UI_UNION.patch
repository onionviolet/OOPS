+.work-ledger-actions button { flex: 0 1 auto; white-space: normal; }
+.work-ledger-actions small { flex-basis: 100%; }
+.work-ledger-presentation { display: flex; flex-wrap: wrap; gap: .55rem; padding: .55rem; min-width: 0; }
+.work-ledger-presentation legend { font-size: .9rem; }
+.work-ledger-presentation label { display: inline-flex; align-items: center; gap: .3rem; }
+.work-ledger-presentation select { max-width: 100%; }
+.work-ledger-presentation small { flex-basis: 100%; }
+.work-ledger-history ol { padding-inline-start: 1.5rem; max-height: 14rem; overflow: auto; }
+.work-ledger-history li { margin-block: .3rem; }
+.work-ledger-notice { min-height: 1em; }
+.work-ledger-effect { pointer-events: none; position: absolute; box-sizing: border-box; inset: 2.3rem .5rem auto; display: flex; align-items: center; gap: .6rem; padding: .7rem; background: #162127ed; color: #e7ecea; border: 1px solid #9bb4ae; border-radius: 5px; z-index: 2; font: inherit; overflow-wrap: anywhere; box-shadow: 0 2px 8px #0004; }
+.work-ledger-effect[hidden] { display: none; }
+.work-ledger-effect-glyph { flex: 0 0 auto; font-size: 1.7em; }
+.work-ledger-effect[data-motif='guidance'] { border-color: #c9c49a; }
+.work-ledger-effect[data-motif='closing'] { border-color: #90999f; }
+.work-ledger-effect[data-presentation='margin'] { inset: 2.3rem .5rem auto auto; width: fit-content; max-width: calc(100% - 1rem); padding: .3rem .7rem; }
+@media (max-width: 480px) { .work-ledger-presentation label { width: 100%; flex-wrap: wrap; } .work-ledger-actions button { flex-basis: 100%; } }
+.work-ledger-effect-glyph { width: 48px; height: 48px; color: #b8d8cf; }
+.work-ledger-effect[data-motif='guidance'] .work-ledger-effect-glyph { color: #e2dca9; }
+.work-ledger-effect[data-motif='closing'] .work-ledger-effect-glyph { color: #aab6c0; }
+.work-ledger-target-pulse { position: absolute; pointer-events: none; box-sizing: border-box; border: 2px solid #c9c49a; border-radius: 4px; z-index: 1; }
+
+.settled-effects-host { position: relative; overflow: hidden; }
+
+.work-ledger-panel { background: #1c243bf7; color: #f1f2f5; }
+.settled-effects-host > .work-ledger-effect { inset: auto .5rem .5rem auto; max-width: min(340px, calc(100% - 1rem)); }
+/* Validated original effect definitions override motifs without touching receipts. */
+.work-ledger-effect { background: var(--settled-background, #162127ed); border-color: var(--settled-color, #9bb4ae); }
+.work-ledger-effect .work-ledger-effect-glyph { color: var(--settled-color, #b8d8cf); }
+.work-ledger-effect[data-motif='guidance'] .work-ledger-effect-glyph { color: var(--settled-color, #e2dca9); }
+.work-ledger-effect[data-motif='closing'] .work-ledger-effect-glyph { color: var(--settled-color, #aab6c0); }
+.work-ledger-effect[data-motif='guidance'], .work-ledger-effect[data-motif='closing'] { border-color: var(--settled-color, #9bb4ae); }
+
+#cancel_craft_visual_effect {position:absolute;right:.5rem;bottom:2.8rem;z-index:4;max-width:calc(100% - 1rem);white-space:normal;}
+
+/* Original paper receipt and decorative ink. No item/reward implication. */
+.work-ledger-effect[data-craft-receipt='true'] { border-radius: 2px; border-inline-start-width: 3px; }
+.quiet-place-detail { display:block; font-size:.8em; line-height:1.3; color:var(--text-color); opacity:.8; padding:.15rem .35rem; overflow-wrap:anywhere; }
+.quiet-place-detail[hidden] { display:none; }
