+#main_content.workspace-active .customization-module .stat_slot_div {
+    display: flex; flex-wrap: wrap; align-items: baseline; gap: .1em .35em;
+    height: auto; min-height: 1.6em; box-sizing: border-box; padding: .15em .3em;
+    outline-color: var(--theme-border); font-variant-numeric: tabular-nums;
+}
+#main_content.workspace-active .customization-module :is(.stat_name, .stat_name_short) {
+    width: auto; min-width: 0; padding: 0; flex: 1 1 auto; overflow-wrap: anywhere;
+}
+#main_content.workspace-active .customization-module :is(.stat_value, .stat_value_long) {
+    width: auto; max-width: 100%; flex: 0 0 auto; margin-inline-start: auto; overflow-wrap: anywhere;
