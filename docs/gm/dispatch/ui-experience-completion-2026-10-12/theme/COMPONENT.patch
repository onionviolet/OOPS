+:is(#main_content.workspace-active, .theme-preview) .customization-module :is(table, .character_bio_entry, .equipped_item_control, .inventory_item_control, #dialogue_answer_div, #dialogue_name_div, #effects_div, .customization-panel) {
+    background: var(--theme-surface) !important; color: var(--theme-surface-text) !important;
