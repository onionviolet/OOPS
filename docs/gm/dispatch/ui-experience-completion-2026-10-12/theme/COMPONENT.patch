+    flex: 1 1 auto; width: auto; float: none;
+}
+#main_content.workspace-active #inventory_combat_switch_selection.customization-module { display: flex; flex-wrap: wrap; }
+#main_content.workspace-active #inventory_combat_switch_selection.customization-module > :is(button, div) {flex: 1 1 auto; width: auto; float: none; font-size: inherit;}
+#main_content.workspace-active .customization-module :is(#character_stats_div, #character_bio_div, #character_equipment_div, #character_tools_div) {width: 100%; max-width: 100%; min-width: 0; box-sizing: border-box;}
+.theme-preview {border: 1px solid currentColor; padding: .5rem; margin-block: .5rem; min-width: 0;}
+.theme-preview-tabs, .theme-action-row {display: flex; flex-wrap: wrap; gap: .35em; margin-block: .4em;}
+.theme-preview .customization-module {padding: var(--custom-spacing);}
+.theme-preview button {padding: .35em .5em;}
+.theme-preview label {display: flex; flex-wrap: wrap; gap: .3em;}
+.theme-preview :is(p, h4) {margin-block: .5em;}
+
+#main_content.workspace-active .customization-module .activable_buttons > div {width: auto; flex: 1 1 auto; float: none; padding: .25em .4em;}
+
+.theme-preview dl {display: grid; grid-template-columns: minmax(0,1fr) minmax(0,1fr); gap: .25em; font-variant-numeric: tabular-nums;}
+.theme-preview dd {margin: 0;}
+
+#main_content.workspace-active .customization-module :is(.recipe_div, .crafting_recipe_list) {width: 100%; max-width: 100%; box-sizing: border-box; font-size: inherit;}
+/* Native numeric pairs retain both label and number as typography grows. */
