+}
+:is(#main_content.workspace-active, .theme-preview) .customization-module :is(th, td) {
+    padding: .3em .45em; border-bottom: 1px solid var(--theme-border); text-align: left;
+}
+:is(#main_content.workspace-active, .theme-preview) .customization-module :is(.theme-warning, [data-theme-state=warning]) {color: var(--theme-warning) !important; border-inline-start: 3px solid var(--theme-warning); padding-inline-start: .5em;}
+:is(#main_content.workspace-active, .theme-preview) .customization-module :is(.theme-danger, [data-theme-state=error], [role=alert]) {color: var(--theme-danger) !important; border-inline-start: 3px solid var(--theme-danger); padding-inline-start: .5em;}
