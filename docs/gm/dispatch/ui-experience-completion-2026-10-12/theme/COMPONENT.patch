+/* Original component contract. Cosmetics do not alter layout ownership or commands.
+   Explicit consumers avoid recoloring health/resource bars and rarity semantics. */
+:is(#main_content.workspace-active, .theme-preview) .customization-module {
+    --workspace-text: var(--theme-text); --workspace-muted: var(--theme-muted);
+    --workspace-accent: var(--theme-accent); --workspace-focus: var(--theme-focus);
+    --workspace-border: var(--theme-border); --workspace-button: var(--theme-control);
+    --al-muted: var(--theme-muted); --al-border: var(--theme-border);
+    --options_action_textsize: var(--custom-size);
+    --tooltip_background_color: var(--theme-surface);
+    color: var(--theme-text) !important; background-color: var(--theme-bg) !important;
+    border-color: var(--theme-border) !important; border-radius: var(--theme-radius);
+    line-height: 1.4; min-width: 0; box-sizing: border-box;
+}
+:is(#main_content.workspace-active, .theme-preview) .customization-module :is(button, .activable_buttons > div, .crafting_mainpage_button, .crafting_subpage_button, .recipe_name, .recipe_item_name, .recipe_comp_name, .selectable_material, .selectable_component, select, input:not([type=color]), textarea, .action_travel, .start_dialogue, .start_trade, .start_game_action, .start_activity, .location_choices, .choices_return_button, .dialogue_textline, .dialogue_trade, .end_dialogue_button, .backstep_dialogue_button) {
+    font-family: var(--custom-font); font-size: var(--custom-size) !important;
+    line-height: 1.3; color: var(--theme-control-text) !important;
+    background: var(--theme-control) !important; border: 1px solid var(--theme-border);
+    border-radius: var(--theme-radius); box-sizing: border-box;
+    min-height: 2em; height: auto; white-space: normal; overflow-wrap: anywhere;
+    max-width: 100%; min-width: 0;
+}
+:is(#main_content.workspace-active, .theme-preview) .customization-module :is(button, .activable_buttons > div, .action_travel, .start_dialogue, .start_trade, .start_game_action, .start_activity, .location_choices, .dialogue_textline):hover:not(:disabled):not([aria-disabled=true]) {
+    background: color-mix(in srgb, var(--theme-accent) 16%, var(--theme-control)) !important;
+}
+:is(#main_content.workspace-active, .theme-preview) .customization-module :is(button:disabled, button[aria-disabled=true], input:disabled, select:disabled, .action_unavailable, .activity_unavailable, .recipe_unavailable, .recipe_unavailable .recipe_item_name) {
+    color: var(--theme-muted) !important; background: var(--theme-bg) !important;
+    border-style: dashed; opacity: 1; cursor: not-allowed;
+}
+:is(#main_content.workspace-active, .theme-preview) .customization-module :is(.active_selection_button, .active_selection, .selected_recipe .recipe_name, .selected_material, .selected_component, [aria-selected=true], button[aria-pressed=true]) {
+    color: var(--theme-selected-text) !important; background: var(--theme-selected) !important;
+    box-shadow: inset 0 -3px 0 var(--theme-border); font-weight: 700;
+}
+:is(#main_content.workspace-active, .theme-preview) .customization-module :is(button, input, select, textarea, summary, a, [tabindex]):focus-visible {
+    outline: 3px solid var(--theme-focus) !important; outline-offset: 2px;
+}
+:is(#main_content.workspace-active, .theme-preview) .customization-module :is(h3, h4, summary) {
+    font-family: var(--theme-heading-font); color: var(--theme-accent);
