    {
      "action": "click",
      "selector": "[data-action-legibility-key=\"action:world.completion.learning.withdraw_shack\"] button",
      "save": "worker-natural-refusal-withdrawn"
    },
    {
      "action": "export",
      "name": "worker-natural-refusal-withdrawn"
    },
    {
      "action": "reload",
      "save": "worker-natural-refusal-reloaded"
    },
    {
      "action": "literalImport",
      "path": "/tmp/yairpg-foundation-learning-worker-natural-refusal-withdrawn.txt",
      "save": "worker-natural-refusal-literal-imported"
