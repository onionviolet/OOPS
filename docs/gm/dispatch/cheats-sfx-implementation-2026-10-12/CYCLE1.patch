+/* Isolated panel geometry follows its workspace host when moved or resized. */
+.work-ledger-panel { position: relative; overflow: hidden; border: 1px solid var(--border-color, #747b83); border-radius: 5px; margin-block: .6rem; padding: .55rem; text-align: left; min-width: 0; }
+.work-ledger-panel > summary { cursor: pointer; font-weight: bold; }
+.work-ledger-body { overflow-wrap: anywhere; }
+.work-ledger-body p { margin-block: .45rem; }
+.work-ledger-body h4 { margin-block: .7rem .35rem; }
+.work-ledger-status { font-weight: bold; }
+.work-ledger-commission { padding: .4rem; margin-block: .4rem; border-left: 2px solid #829397; background: #81959612; }
+.work-ledger-actions { display: flex; flex-wrap: wrap; gap: .35rem; margin-block: .7rem; }
+.work-ledger-actions button { flex: 0 1 auto; white-space: normal; }
+.work-ledger-actions small { flex-basis: 100%; }
+.work-ledger-presentation { display: flex; flex-wrap: wrap; gap: .55rem; padding: .55rem; min-width: 0; }
+.work-ledger-presentation legend { font-size: .9rem; }
+.work-ledger-presentation label { display: inline-flex; align-items: center; gap: .3rem; }
+.work-ledger-presentation select { max-width: 100%; }
+.work-ledger-presentation small { flex-basis: 100%; }
+.work-ledger-history ol { padding-inline-start: 1.5rem; max-height: 14rem; overflow: auto; }
+.work-ledger-history li { margin-block: .3rem; }
+.work-ledger-notice { min-height: 1em; }
+.work-ledger-effect { pointer-events: none; position: absolute; box-sizing: border-box; inset: 2.3rem .5rem auto; display: flex; align-items: center; gap: .6rem; padding: .7rem; background: #162127ed; color: #e7ecea; border: 1px solid #9bb4ae; border-radius: 5px; z-index: 2; font: inherit; overflow-wrap: anywhere; box-shadow: 0 2px 8px #0004; }
