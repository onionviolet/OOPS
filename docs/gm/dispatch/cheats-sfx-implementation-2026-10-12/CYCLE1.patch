+.work-ledger-effect[data-motif='guidance'] .work-ledger-effect-glyph { color: #e2dca9; }
+.work-ledger-effect[data-motif='closing'] .work-ledger-effect-glyph { color: #aab6c0; }
+.work-ledger-target-pulse { position: absolute; pointer-events: none; box-sizing: border-box; border: 2px solid #c9c49a; border-radius: 4px; z-index: 1; }
+
