+ const title=document.createElement('summary');title.textContent='Original System rules';panel.append(title);
+ const explain=document.createElement('p');explain.textContent='Edit the original Work Ledger. Power values affect acquired functions. Accepted commissions keep their saved terms. Native inputs, chance limits, output and time still belong to crafting.';panel.append(explain);
+ const editor=document.createElement('textarea');editor.id='work_ledger_rules_draft';editor.rows=16;editor.setAttribute('aria-label','Original Work Ledger rule draft');panel.append(editor);
+ const status=document.createElement('p');status.setAttribute('role','status');panel.append(status);
+ let dirty=false,busy=false;editor.addEventListener('input',()=>dirty=true);
+ const button=(id,label,action,persist=true)=>{const b=document.createElement('button');b.id=id;b.type='button';b.textContent=label;b.onclick=async()=>{if(busy)return;try{busy=true;refresh();await action();if(persist){dirty=false;status.textContent='Saved.';refresh(true);}else status.textContent='Draft exported.';}catch(e){status.textContent=e.message;}finally{busy=false;refresh();}};panel.append(b);return b;};
