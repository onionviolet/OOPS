      "knowledge": {
        "player": {
          "book.lotm.sv.terms": {
            "stage": "understood",
            "value": "One prepared dose now sits in your hands under the records officer's allocation. The Machinery team keeps its line to its own probationers: you are not offered another church's potion. Holding it grants nothing; you can still decline.",
            "at": 0,
            "cause": "simulation:3",
            "basis": {
              "kind": "instruction",
              "attributedTo": "player",
              "situationId": "book.lotm.probationer_branch"
            }
          },
          "book.lotm.sv.stabilized": {
            "stage": "understood",
            "value": "The dose is gone for good. Facts rose faster than you could name them, then settled into order. You hold a Savant source. The officer says the potion is digested by living as a Savant, studying and applying, and that the church will not examine you for years whatever you recall.",
            "at": 0,
            "cause": "simulation:4",
            "basis": {
              "kind": "observation",
              "attributedTo": "player",
              "situationId": "book.lotm.probationer_branch"
            }
          },
          "missed.shower": {
            "stage": "seen",
            "value": "The shower passed; the craftsman dried his bench. No missed reward is owed.",
            "at": 20,
            "cause": "expire:7"
          },
          "book.lotm.sv.acting.study": {
            "stage": "understood",
            "value": "You studied until you could say how each mechanism failed and why. Treating what you know as something to apply, not to hoard, settles something in you a little more each time.",
            "at": 90,
            "cause": "simulation:9",
            "basis": {
              "kind": "observation",
              "attributedTo": "player",
              "situationId": "book.lotm.probationer_branch"
            }
          },
          "book.lotm.sv.acting.apply": {
            "stage": "understood",
            "value": "You turned the ledger into a number someone paid. Applying knowledge, the Savant's other half, counted.",
            "at": 135,
            "cause": "simulation:10",
            "basis": {
              "kind": "observation",
              "attributedTo": "player",
              "situationId": "book.lotm.probationer_branch"
            }
          },
          "book.lotm.sv.assessment": {
            "stage": "understood",
            "value": "The records officer tested your recall and judged the potion digested. That is only the local pre-screen: the senior deacon examines, and the church waits out its term first.",
            "at": 135,
            "cause": "simulation:11",
            "basis": {
              "kind": "instruction",
              "attributedTo": "player",
              "situationId": "book.lotm.probationer_branch"
            }
          }
        }
