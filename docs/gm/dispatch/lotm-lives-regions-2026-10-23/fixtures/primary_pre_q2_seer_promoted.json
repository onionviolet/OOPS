ckpoints":{},"chronicle":null,"simulation":{"schema":3,"seed":2637116831,"enrolledAt":0,"people":{"player":{"life":"alive","inventory":"native","location":"Tingen supervised workroom","bornAt":0,"body":{"id":"native.player.body","form":"human","hands":2,"mobile":true,"ownerId":"player","controllerId":"player"}},"oldCraftsman":{"life":"alive","inventory":"native","location":"Village","bornAt":0,"definitionId":"oldCraftsman","definitionRevision":1},"book.lotm.supervisor":{"life":"alive","inventory":"native","location":"Tingen supervised workroom","bornAt":0,"definitionId":"book.lotm.supervisor","definitionRevision":1,"vitals":{"health":24,"max_health":24,"stamina":18,"max_stamina":18},"body":{"id":"native.person.book.lotm.supervisor.body","form":"human","hands":2,"mobile":true,"ownerId":"book.lotm.supervisor","controllerId":"book.lotm.supervisor"}}},"owners":{},"equipment":{},"custody":{},"knowledge":{"player":{"book.lotm.terms":{"stage":"understood","value":"One prepared dose now sits in your hands under the supervisor's allocation. Taking it into your body is a separate, irreversible step: you can still decline, and holding it grants nothing. Disturbed senses and trouble focusing follow ingestion; guided attention on a familiar object eases them. Supervision is not a guarantee for every recipient.","at":0,"cause":"simulation:3","basis":{"kind":"instruction","attributedTo":"player","situationId":"book.lotm.probationer_branch"}},"book.lotm.stabilized":{"stage":"understood","value":"The dose is gone for good. Senses flared, whispers pressed in, and holding your attention on a familiar object under the supervisor's guidance brought them down. You hold a Seer source but no method: control is taught, not given. This reading shows what happened to one supervised body, not that every novice is safe.","at":0,"cause":"simulation:4","basis":{"kind":"observation","attributedTo":"player","situationId":"book.lotm.probationer_branch"}},"book.lotm.method":{"stage":"understood","value":"You can now deliberately look at one material in front of you and end the sight. It costs spirituality and tires you; it shows presence at the material, not identity, safety or future. Ending the sight stops new cost; it does not undo fatigue.","at":5,"cause":"simulation:5","basis":{"kind":"instruction","attributedTo":"player","situationId":"book.lotm.probationer_branch"}},"book.lotm.acting.reading":{"stage":"understood","value":"You read for a client and kept it vague: a hint, never a promise. Staying inside the Seer's role, curious about fate but wary of it, settles something in you a little more each time.","at":175,"cause":"simulation:13","basis":{"kind":"observation","attributedTo":"player","situationId":"book.lotm.probationer_branch"}},"missed.shower":{"stage":"seen","value":"The shower passed; the craftsman dried his bench. No missed reward is owed.","at":20,"cause":"expire:9"},"book.lotm.acting.refusal":{"stage":"understood","value":"You turned down the request to look at a powerful person. Fearing what fate might show is also part of the role, and that restraint counted.","at":175,"cause":"simulation:14","basis":{"kind":"observation","attributedTo":"player","situationId":"book.lotm.probationer_branch"}},"book.lotm.assessment":{"stage":"understood","value":"Hale tested you and judged the Seer potion digested. The workroom releases one prepared Clown dose from its stores. Holding it grants nothing; drinking it is another irreversible step.","at":175,"cause":"simulation:15","basis":{"kind":"instruction","attributedTo":"player","situationId":"book.lotm.probationer_branch"}},"book.lotm.promoted":{"stage":"understood","value":"The Clown potion is gone for good. The same whispers rose and passed. Your body answers faster and steadier, and your face holds whatever you set on it. This Sequence needs digesting in turn, by its own role.","at":175,"cause":"simulation:16","basis":{"kind":"observation","attributedTo":"player","situationId":"book.lotm.probationer_bra