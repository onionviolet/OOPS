// Shared harness only. Each lane owns a fresh browser context and evidence directory.
const fs=require('fs'),path=require('path'),assert=require('assert/strict'),crypto=require('crypto');
const {chromium}=require('/Users/weiwei/.cache/codex-runtimes/codex-primary-runtime/dependencies/node/node_modules/playwright');
const hash=x=>crypto.createHash('sha256').update(x).digest('hex');
module.exports=async function nativeGate(lane,run,{deterministic=false}={}){
 if(!process.env.URL)throw Error('URL must name the served build.');
 const u=new URL(process.env.URL);u.search='';u.hash='';assert.match(u.protocol,/^https?:$/);const base=u.href.replace(/\/?$/,'/');
 const target=deterministic?new URL('?test_hooks=1',base).href:base;
 const root=process.env.YAIRPG_PROOF_DIR||require('os').tmpdir();fs.mkdirSync(root,{recursive:true});
 const out=fs.mkdtempSync(path.join(root,lane+'-'));
 const b=await chromium.launch({channel:'chrome',headless:true}),c=await b.newContext({viewport:{width:1366,height:768},acceptDownloads:true}),p=await c.newPage();p.setDefaultTimeout(90000);
 const errors=[],gates=[],loaded=[];p.on('pageerror',e=>errors.push(e.message));p.on('response',r=>{if(r.status()===200&&new URL(r.url()).pathname===new URL('dist/bundle.js',base).pathname&&new URL(r.url()).origin===new URL(base).origin)loaded.push(r.body().then(hash));});
 const read=()=>p.evaluate(()=>JSON.parse(localStorage.getItem('save data')));
 const save=async()=>{await p.locator('#save_button').click();return read();};
 const play=async()=>{await p.locator('#loading_screen_play_button:not(.none_display)').click({noWaitAfter:true});if(deterministic)await p.evaluate(()=>{simulationTestHooks.pause();advanceTicks(1,{render:true});});};
 const open=async()=>p.evaluate(()=>document.querySelectorAll('details').forEach(d=>{d.open=!d.closest('.workspace-toolbar,.workspace-module-controls');}));
 // Use the native keyboard activation route. The sticky workspace toolbar can
 // cover pointer targets after scrolling, even when the authored button is visible.
 const keyboard=async locator=>{await locator.waitFor({state:'visible'});for(let n=0;n<100&&!await locator.isEnabled();n++)await p.waitForTimeout(100);assert.equal(await locator.isEnabled(),true,'Authored native action is eligible');await locator.press('Enter');};
 const button=async text=>{const escaped=text.replace(/[.*+?^${}()|[\]\\]/g,'\\$&'),name=new RegExp('^(?:Do this: )?'+escaped+'$');
  for(let n=0;n<100;n++){await open();const candidate=p.getByRole('button',{name}).first();if(await candidate.count()&&await candidate.isVisible()){await keyboard(candidate);return;}await p.waitForTimeout(100);}throw Error('Native authored button unavailable: '+text);};
 const act=async(selector,id)=>{for(let n=0;n<100;n++){await open();const candidate=p.locator(`[${selector}="${id}"]`);if(await candidate.count()&&await candidate.isVisible()){await keyboard(candidate);return;}await p.waitForTimeout(100);}throw Error('Native authored action unavailable: '+id);};
 const load=async(s,tag='fixture')=>{const file=path.join(out,tag+'.save.txt');fs.writeFileSync(file,'YAIR-UTF8-1:'+Buffer.from(JSON.stringify(s)).toString('base64'));await Promise.all([p.waitForNavigation({waitUntil:'domcontentloaded'}),p.locator('#saved_file_input').setInputFiles(file)]);await play();};
 const roundtrip=async(tag,project)=>{const saved=await save();await p.reload({waitUntil:'domcontentloaded'});const reloaded=await read();if(deterministic)assert.deepEqual(project(reloaded),project(saved));await play();
  const download=p.waitForEvent('download');await p.locator('#save_to_file_button').click();const file=path.join(out,tag+'.save.txt');await(await download).saveAs(file);
  const literal=JSON.parse(Buffer.from(fs.readFileSync(file,'utf8').trim().replace(/^YAIR-UTF8-1:/,''),'base64').toString());
  await Promise.all([p.waitForNavigation({waitUntil:'domcontentloaded'}),p.locator('#saved_file_input').setInputFiles(file)]);assert.deepEqual(project(await read()),project(literal));await play();gates.push(tag+': native Save/reload/Export/literal-file Import');return {reloaded,literal};};
 const played=async(n)=>{const start=(await save()).expansion.clock;for(let i=0;i<n*3+15;i++){if(deterministic)await p.evaluate(()=>advanceTicks(1));else await p.waitForTimeout(1100);if((await save()).expansion.clock>=start+n)return;}throw Error('Native played clock stopped.');};
 const until=async(predicate,label,timeout=90000)=>{const end=Date.now()+timeout;while(Date.now()<end){const s=await save();if(predicate(s))return s;if(deterministic)await p.evaluate(()=>advanceTicks(1));else await p.waitForTimeout(1100);}throw Error('Timed native gate: '+label);};
 const reject=async(s,tag)=>{const file=path.join(out,tag+'.save.txt');fs.writeFileSync(file,'YAIR-UTF8-1:'+Buffer.from(JSON.stringify(s)).toString('base64'));const before=await p.evaluate(()=>localStorage.getItem('save data'));await p.locator('#saved_file_input').setInputFiles(file);await p.waitForTimeout(150);assert.equal(await p.evaluate(()=>localStorage.getItem('save data')),before);gates.push(tag+': literal unsupported schema rejected before mutation');};
 const quota=async(selector,project)=>{await save();const result=await p.evaluate(sel=>{const prior=localStorage.getItem('save data'),old=Storage.prototype.setItem;Storage.prototype.setItem=function(k,v){if(k==='save data')throw new DOMException('Test quota','QuotaExceededError');return old.call(this,k,v);};try{document.querySelector(sel).click();return {prior,after:localStorage.getItem('save data')};}finally{Storage.prototype.setItem=old;}},selector);assert.equal(result.after,result.prior);gates.push('Native choice quota failure preserves prior durable save');await p.reload({waitUntil:'domcontentloaded'});await play();};
 const boot=async()=>{const f=JSON.parse(fs.readFileSync(path.join(__dirname,'..','fixtures','tranche1-prelight.json')));f['current location']='Village';f.character.money=5000;f.character.hp_to_full=0;f.active_effects={};f.availabilities.skill.Meditation=1;f.availabilities.trader.villageTrader=1;f.pacing_e1.hungerEnabled=false;f.pacing_e1.weatherEnabled=false;await p.goto(base+'style.css');await p.evaluate(s=>localStorage.setItem('save data',JSON.stringify(s)),f);await p.goto(target,{waitUntil:'domcontentloaded'});await play();return save();};
 const enroll=async()=>{for(const id of ['villageElder','oldCraftsman']){await p.evaluate(id=>window.start_dialogue(id),id);const hello=p.locator('[data-textline="hello"]');if(await hello.count())await hello.click();await p.evaluate(()=>window.end_dialogue());if(deterministic)await p.evaluate(()=>advanceTicks(1,{render:true}));}await p.locator('#systems_workshop_panel').waitFor({state:'visible'});await open();await keyboard(p.locator('#systems_workshop_panel [data-systems="enroll"]'));assert.ok((await save()).expansion.simulation);};
 const proto=async()=>{await button('Read the Proto23 independent visitor terms');await button('Choose independent Proto23 guest entry');await button('Enter your retained Proto23 visitor village');assert.equal((await save())['current location'],'Proto23 Village Center');await button('Read the guest steward’s current village board');};
 try{await run({p,out,assert,fs,path,gates,read,save,play,open,button,act,load,roundtrip,played,until,reject,quota,boot,enroll,proto});
  const served=await p.request.get(base+'dist/bundle.js');assert.equal(served.status(),200);const bytes=await served.body(),bundle=hash(bytes);assert.equal(bundle,hash(fs.readFileSync('dist/bundle.js')));assert.deepEqual([...new Set(await Promise.all(loaded))],[bundle]);assert.deepEqual(errors,[]);await p.screenshot({path:path.join(out,lane+'-desktop.png')});fs.writeFileSync(path.join(out,lane+'.json'),JSON.stringify({status:'PASS',lane,viewport:'1366x768',bundleSha256:bundle,gates,pageErrors:errors,prerequisites:'Immutable old baseline: earned Shack permission, native Meditation admission, money and ordinary inventory controls. All new families created by native opt-ins; optional counter control labelled where used.'},null,2));console.log(lane+' PASS '+out);
 }catch(e){await p.screenshot({path:path.join(out,lane+'-FAIL.png')}).catch(()=>{});fs.writeFileSync(path.join(out,lane+'-FAIL.json'),JSON.stringify({status:'FAIL',message:e.message,gates,pageErrors:errors},null,2));throw e;}finally{await c.close();await b.close();}
};
