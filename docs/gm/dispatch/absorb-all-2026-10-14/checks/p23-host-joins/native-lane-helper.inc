// Shared harness only. Each .cjs creates its own browser, fresh context and output.
const fs=require('fs'),path=require('path'),os=require('os'),assert=require('assert/strict'),crypto=require('crypto');
const {chromium}=require('/Users/weiwei/.cache/codex-runtimes/codex-primary-runtime/dependencies/node/node_modules/playwright');
function fixture(name='tranche1-prelight.json') {return JSON.parse(fs.readFileSync(path.join(__dirname,'fixtures',name),'utf8'));}
function village(f=fixture()){f['current location']='Village';f.character.money=10000;f.character.hp_to_full=0;f.character.stamina_to_full=0;f.availabilities.trader.villageTrader=1;delete f.character.long_life_worn;for(const key of ['field_familiarity_p07','p23_market_life','p23_leisure_memory','absorb_repeat_search','p23_drop_observations'])delete f[key];return f;}
const encode=s=>'YAIR-UTF8-1:'+Buffer.from(JSON.stringify(s),'utf8').toString('base64');
async function run(lane,body){
 if(!process.env.URL)throw Error('Set URL to the rebuilt native origin.');const base=new URL(process.env.URL).href.replace(/\/?$/,'/');
 const root=process.env.YAIRPG_PROOF_DIR||os.tmpdir();fs.mkdirSync(root,{recursive:true});const out=fs.mkdtempSync(path.join(root,lane+'-'));
 const browser=await chromium.launch({channel:'chrome',headless:true}),context=await browser.newContext({viewport:{width:1366,height:768}}),page=await context.newPage();
 const errors=[],gates=[],limitations=[],loaded=[];page.on('pageerror',e=>errors.push(e.message));page.on('response',r=>{if(r.status()===200&&new URL(r.url()).pathname===new URL('dist/bundle.js',base).pathname&&new URL(r.url()).origin===new URL(base).origin)loaded.push(r.body().then(b=>crypto.createHash('sha256').update(b).digest('hex')));});
 const play=async()=>{await page.locator('#loading_screen_play_button:not(.none_display)').click();};
 const seed=async(f)=>{await page.goto(new URL('style.css',base).href);await page.evaluate(s=>{localStorage.clear();localStorage.setItem('save data',JSON.stringify(s));},f);await page.goto(base);await play();};
 const read=()=>page.evaluate(()=>JSON.parse(localStorage.getItem('save data')));
 const save=async()=>{await page.locator('#save_button').click();return read();};
 const open=async id=>{const panel=page.locator('#'+id);await panel.waitFor();if(!await panel.evaluate(n=>n.open))await panel.locator('summary').click();};
 const click=async(id,attribute='p23-local')=>{await open(attribute==='local-life-action'?'local_life_panel':'p23_tranche_four_panel');await page.locator('[data-'+attribute+'="'+id+'"]').click();};
 const until=async predicate=>{for(let n=0;n<100;n++){const s=await save();if(predicate(s))return s;await page.waitForTimeout(500);}throw Error('Native condition did not settle.');};
 const persist=async(label,project)=>{const before=await save();await page.reload();assert.deepEqual(project(await read()),project(before));await play();const settled=await save(),download=page.waitForEvent('download');await page.locator('#save_to_file_button').click();const file=path.join(out,label+'.save.txt');await(await download).saveAs(file);await Promise.all([page.waitForNavigation(),page.locator('#saved_file_input').setInputFiles(file)]);assert.deepEqual(project(await read()),project(settled));await play();gates.push(label+': Save/reload/Export/literal-file Import');return read();};
 const reject=async(key)=>{const candidate=await save();const raw=key.split('/').reduce((v,k)=>v[k],candidate);raw.schema=999;const proof=await page.evaluate(async text=>{const before=localStorage.getItem('save data');await window.load_progress(text);return {before,after:localStorage.getItem('save data'),text:document.body.innerText};},encode(candidate));assert.equal(proof.after,proof.before);assert.match(proof.text,/Import rejected/);gates.push(key+': unsupported-schema rejected before durable mutation');};
 const quota=async action=>{const bioVisible=await page.locator('#titles_panel').isVisible();await save();await page.evaluate(()=>{window.__p00BeforeQuota=localStorage.getItem('save data');window.__p00SetItem=Storage.prototype.setItem;Storage.prototype.setItem=function(k,v){if(k==='save data')throw new DOMException('Native gate quota','QuotaExceededError');return window.__p00SetItem.call(this,k,v);};});try{await action();const same=await page.evaluate(()=>localStorage.getItem('save data')===window.__p00BeforeQuota);assert.equal(same,true);}finally{await page.evaluate(()=>{Storage.prototype.setItem=window.__p00SetItem;delete window.__p00SetItem;delete window.__p00BeforeQuota;});}gates.push('forced save quota: prior durable native bytes retained');await page.reload();await play();if(bioVisible&&!await page.locator('#titles_panel').isVisible())await page.locator('#character_show_bio').click();};
 try{await body({page,context,seed,read,save,open,click,until,persist,reject,quota,gates,limitations,out,base});assert.deepEqual(errors,[]);const served=await page.request.get(new URL('dist/bundle.js',base).href);assert.equal(served.status(),200);const hash=crypto.createHash('sha256').update(await served.body()).digest('hex');const hashes=[...new Set(await Promise.all(loaded))];assert.deepEqual(hashes,[hash]);await page.screenshot({path:path.join(out,'desktop.png')});fs.writeFileSync(path.join(out,'result.json'),JSON.stringify({lane,status:'PASS',viewport:'1366x768',bundleSha256:hash,gates,limitations,pageErrors:errors},null,2));console.log(lane+' PASS '+out);}catch(e){fs.writeFileSync(path.join(out,'failure.json'),JSON.stringify({lane,error:e.stack,gates,limitations,pageErrors:errors},null,2));throw e;}finally{await context.close();await browser.close();}
}
module.exports={run,fixture,village,assert};
