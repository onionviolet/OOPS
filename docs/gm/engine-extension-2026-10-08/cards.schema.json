    "operation": {
      "type": "object",
      "properties": {
        "worldId": {
          "type": "string",
          "pattern": "^[a-z][a-zA-Z0-9_.:-]*$",
          "maxLength": 96
        },
        "operationKind": {
          "enum": [
            "revival",
            "rewind",
            "regression",
            "succession",
            "offline"
          ]
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "anchorPolicyId": {
          "type": "string",
          "pattern": "^[a-z][a-zA-Z0-9_.:-]*$",
          "maxLength": 96
        },
        "trigger": {
          "enum": [
            "chosen",
            "death",
            "deadline"
          ]
        },
        "historyModel": {
          "enum": [
            "body_only",
            "replace_branch",
            "fork_branch",
            "new_life"
          ]
        },
        "restoreDomains": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-zA-Z0-9_.:-]*$",
            "maxLength": 96
          },
          "uniqueItems": true
        },
        "retainDomains": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-zA-Z0-9_.:-]*$",
            "maxLength": 96
          },
          "uniqueItems": true
        },
        "observerPolicyId": {
          "type": "string",
          "pattern": "^[a-z][a-zA-Z0-9_.:-]*$",
          "maxLength": 96
        },
        "rewardScope": {
          "enum": [
            "campaign",
            "life",
            "branch",
            "loop"
          ]
        },
        "rngPolicy": {
          "enum": [
            "retain",
            "restore_anchor",
            "branch_stream"
          ]
        },
        "costs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "ownerId": {
                "type": "string",
                "minLength": 1
              },
              "resourceId": {
                "type": "string",
                "pattern": "^[a-z][a-zA-Z0-9_.:-]*$",
                "maxLength": 96
              },
              "amount": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "ownerId",
              "resourceId",
              "amount"
            ],
            "additionalProperties": false
          }
        },
        "adapterId": {
          "type": "string",
          "pattern": "^[a-z][a-zA-Z0-9_.:-]*$",
          "maxLength": 96
        }
      },
      "required": [
        "worldId",
        "operationKind",
        "target",
        "anchorPolicyId",
        "trigger",
        "historyModel",
        "restoreDomains",
        "retainDomains",
        "observerPolicyId",
        "rewardScope",
        "rngPolicy",
        "costs",
        "adapterId"
      ],
