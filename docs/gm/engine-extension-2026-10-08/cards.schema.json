  "$defs": {
    "world": {
      "type": "object",
      "properties": {
        "premise": {
          "type": "string",
          "minLength": 1
        },
        "signatureLaws": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "maxItems": 3
        },
        "absences": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[a-z][a-zA-Z0-9_.:-]*$",
                "maxLength": 96
              },
              "value": {
                "oneOf": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "type": "boolean"
                  }
                ]
              },
              "knownReason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "key",
              "value",
              "knownReason"
            ],
            "additionalProperties": false
          },
          "minItems": 2
        },
        "rules": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "boolean"
              },
              {
                "type": "object",
                "properties": {
                  "numerator": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "denominator": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "numerator",
                  "denominator"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "growthFamilies": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-zA-Z0-9_.:-]*$",
            "maxLength": 96
          },
          "uniqueItems": true
        },
        "displayMode": {
          "enum": [
            "native",
            "prose",
            "descriptors",
            "system"
          ]
        },
        "stance": {
          "type": "string",
          "minLength": 1
        },
        "scarcity": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "deckIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-zA-Z0-9_.:-]*$",
            "maxLength": 96
          },
          "uniqueItems": true
        },
        "doorIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-zA-Z0-9_.:-]*$",
            "maxLength": 96
          },
          "uniqueItems": true
        },
        "placeIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-zA-Z0-9_.:-]*$",
            "maxLength": 96
          },
          "uniqueItems": true
        },
        "clockPolicyId": {
          "type": "string",
          "pattern": "^[a-z][a-zA-Z0-9_.:-]*$",
          "maxLength": 96
        },
        "swapTest": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "premise",
        "signatureLaws",
        "absences",
        "rules",
        "growthFamilies",
        "displayMode",
        "stance",
        "scarcity",
        "deckIds",
        "doorIds",
        "placeIds",
        "clockPolicyId",
        "swapTest"
      ],
      "additionalProperties": false
    },
    "place": {
      "type": "object",
      "properties": {
        "worldId": {
          "type": "string",
          "pattern": "^[a-z][a-zA-Z0-9_.:-]*$",
          "maxLength": 96
        },
        "nativeLocationId": {
          "type": "string",
          "minLength": 1
        },
        "rules": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "boolean"
              },
              {
                "type": "object",
                "properties": {
