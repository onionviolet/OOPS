{
  "schema": 1,
  "packet": {
    "id": "BOH-P01",
    "title": "A difficult manual with a useful failed attempt",
    "paths": [
      "BH01",
      "BH02",
      "BH03",
      "BH07"
    ],
    "proposal": "One original manual can be mastered through the existing paid instruction or a bounded prepared reading attempt. The attempt uses current body/attention, a relevant sample and permitted desk; a real failed trial retains a diagnostic note and spent effort, while a later specific treatment restores availability.",
    "reuse": "Native reading/item state plus existing sources/knowledge/body/status care/common clock/durable publication. Existing Eda/Neri paid datum lessons remain their own completed content.",
    "new_gap": "A manual-specific prepared rescue window and failed diagnostic consumer, with object mastery distinct from the actor's earned procedure.",
    "choices": [
      "Pay for qualified instruction",
      "Attempt prepared study",
      "Keep the manual unread"
    ],
    "migration": "Optional additive stable-ID record absent on old saves; no retroactive fatigue, knowledge or reward. Define cancellation and failed-persistence effects through current owners.",
    "acceptance": "Later fresh-origin journey: failed attempt -> exact diagnostic -> relevant treatment/preparation -> earned usable procedure -> reload retains independent book/mastery/actor facts.",
    "status": "original-proposal-only",
    "accepted": false,
    "implemented": false,
    "all_gameplay_checks": "deferred; later gate, not a current test request"
  },
  "selected_paths": [
    {
      "id": "BH02",
      "title": "Reading success, rescue and failure",
      "source": "definitions-plus-interpreter",
      "content_scope": "base",
      "status": "selected-dependency-chain-source-reviewed",
      "chain": "The Forge-6 book needs an ability and sufficient Forge to master. Mastery mutates the physical book and spawns a specific lesson; rereading spawns Foresight instead. Under-strength attempts draw three opportunities and allow slot-based rescue, with dynamic alternatives rechecking the current ingredients.",
      "boundary": "Exhausted opportunities lead to fatigue, consolation and soul-specific malady-risk links. Only Forge success and Phost/Lantern risk were followed; other principle branches were inventoried or sampled, not all reviewed.",
