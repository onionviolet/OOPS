+    def test_probe_decodes_invalid_utf8_gracefully(self):
+        """Invalid UTF-8 bytes in child output must not raise UnicodeDecodeError."""
+        program = ('import os,sys; '
+                   'os.write(1,bytes.fromhex("76657273696f6e3a20e29c9320ff0a")); '
+                   'os.write(2,bytes.fromhex("7761726e696e673a20fe0a")); '
+                   'sys.exit(7)')
+        row = self.row(probe=[program])
+        result = toolsets.diagnose(row, dict(os.environ), True)
+        self.assertEqual(result['state'], 'probe-failed')
+        self.assertEqual(result['exit_code'], 7)
+        self.assertIsInstance(result['stdout'], str)
+        self.assertIsInstance(result['stderr'], str)
+        self.assertTrue(result['stdout'].endswith('\n'))
+        self.assertTrue(result['stderr'].endswith('\n'))
+        # Must remain JSON-serializable
+        json.dumps(result, ensure_ascii=False).encode('utf-8')
