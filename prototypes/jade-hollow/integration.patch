+  }
+/* Cultivation prototype: isolated styling, native keyboard-accessible controls. */
+#cultivation_launcher { color: #c8e8d4; background: #19372b; border: 1px solid #688874; border-radius: 4px; cursor: pointer; font: inherit; padding: 3px 9px; }
+#cultivation_panel { box-sizing: border-box; width: min(960px, 94vw); max-height: 90vh; overflow: auto; background: #15251f; color: #eae7d8; border: 1px solid #718374; border-radius: 14px; padding: 26px; font: 15px/1.5 system-ui, sans-serif; box-shadow: 0 24px 90px #0009; }
+#cultivation_panel::backdrop { background: #08130ee0; }
+#cultivation_panel header { display: flex; justify-content: space-between; align-items: start; }
+#cultivation_panel h1 { font: 36px/1.15 Georgia, serif; margin: 8px 0; color: #f2edd9; }
+#cultivation_panel h2 { font: 20px/1.3 Georgia, serif; margin: 8px 0 12px; }
+#cultivation_panel small { font-size: 10px; letter-spacing: 1.7px; color: #a1b8a6; }
+#cultivation_panel p { margin: 8px 0 14px; }
+#cultivation_panel .cultivation_intro { color: #b9c7bc; }
+#cultivation_panel .cultivation_status { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px; margin: 20px 0; color: #e1c686; }
+#cultivation_panel .cultivation_meters, #cultivation_panel .cultivation_cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
+#cultivation_panel .cultivation_meters strong { float: right; font-size: 12px; }
+#cultivation_panel progress { display: block; width: 100%; height: 7px; margin-top: 8px; accent-color: #9cbda2; }
+#cultivation_panel .cultivation_cards section { background: #1d3028; border: 1px solid #3a4c40; border-radius: 9px; padding: 17px; }
+#cultivation_panel .cultivation_cards p { font-size: 12px; color: #becbbf; }
+#cultivation_panel button, #cultivation_panel select { font: inherit; color: #eee9d9; background: #30493b; border: 1px solid #6e8876; border-radius: 5px; padding: 8px 10px; cursor: pointer; }
+#cultivation_panel button:hover:enabled { background: #415f4c; }
+#cultivation_panel button:focus-visible, #cultivation_panel select:focus-visible { outline: 3px solid #e0c580; outline-offset: 2px; }
+#cultivation_panel button:disabled { opacity: .42; cursor: default; }
+#cultivation_panel .cultivation_cards button { display: block; width: 100%; text-align: left; font-size: 12px; margin: 8px 0; }
+#cultivation_panel .cultivation_legacy { display: grid; grid-template-columns: 1fr; gap: 10px; border-top: 1px solid #53664f; margin-top: 22px; padding-top: 20px; }
+#cultivation_panel .cultivation_legacy p { font-size: 12px; color: #becbbf; }
+#cultivation_panel select { display: block; width: 100%; margin-top: 7px; }
+#cultivation_reset_review { border: 1px solid #c6ad77; padding: 15px; margin-top: 15px; border-radius: 7px; }
+#cultivation_message { color: #ead69c; border-left: 2px solid #a18d59; padding-left: 12px; }
+#cultivation_panel footer { font-size: 11px; color: #9eada2; }
+@media (max-width: 700px) { #cultivation_panel {padding: 18px;} #cultivation_panel .cultivation_cards {grid-template-columns: 1fr;} #cultivation_panel .cultivation_meters {gap: 8px; font-size: 11px;} }
