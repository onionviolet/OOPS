        "target": {
          "kind": "self",
          "count": 1,
          "disposition": "any",
          "requiresSight": false,
          "sizes": [],
          "creatureTypes": []
        },
        "area": null,
        "range": {
          "kind": "self",
          "feet": 0,
          "longFeet": 0
        },
        "castingTime": {
          "unit": "passive",
          "value": 0,
          "trigger": null,
          "ritual": false
        },
        "resolution": {
          "kind": "none"
        },
        "damage": [],
        "healing": null,
        "conditions": [],
        "duration": {
          "unit": "source",
          "value": 0,
          "ends": []
        },
        "concentration": false,
        "components": {
          "verbal": false,
          "somatic": false,
          "materials": []
        },
        "rules": [],
        "notes": [
          "Each level subtracts 2 from D20 Tests and 5 feet from Speed; six levels cause death. A Long Rest removes one level; zero ends the condition."
        ]
      }
